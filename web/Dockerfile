FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG NEXT_PUBLIC_HOSPITAL_A_API_URL=http://localhost:8081
ARG NEXT_PUBLIC_HOSPITAL_B_API_URL=http://localhost:8082
ENV NEXT_PUBLIC_HOSPITAL_A_API_URL=$NEXT_PUBLIC_HOSPITAL_A_API_URL
ENV NEXT_PUBLIC_HOSPITAL_B_API_URL=$NEXT_PUBLIC_HOSPITAL_B_API_URL
RUN npm run build
EXPOSE 3000
CMD ["npm","run","start","--","--host","0.0.0.0"]
