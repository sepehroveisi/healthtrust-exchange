FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /rc2-demo-api ./cmd/rc2-demo-api

FROM alpine:3.21
RUN adduser -D -H healthtrust
USER healthtrust
COPY --from=build /rc2-demo-api /rc2-demo-api
COPY --from=build /src/migrations/authority_ledger /migrations/authority_ledger
ENTRYPOINT ["/rc2-demo-api"]
